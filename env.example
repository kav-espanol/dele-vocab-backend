# Resend API 키 — https://resend.com 에서 가입 후 발급 (무료 티어: 월 3,000통)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# 발신 이메일 주소 — Resend에서 도메인 인증을 마치기 전까지는
# onboarding@resend.dev 를 그대로 써도 테스트 가능합니다.
FROM_EMAIL=onboarding@resend.dev

# 프론트엔드(앱)가 배포된 주소 — CORS 허용 목적
# 로컬에서 테스트할 땐 그냥 * 로 둬도 됩니다.
FRONTEND_ORIGIN=*

# 서버 포트 (배포 플랫폼이 자동으로 지정하는 경우가 많아 보통 안 건드려도 됩니다)
PORT=3000
